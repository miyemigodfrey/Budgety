# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string → URI
#
# Both urls use the SESSION pooler (port 5432).
#
# IMPORTANT: do NOT use the transaction pooler (port 6543) for DATABASE_URL. The
# balance engine relies on Prisma interactive transactions with
# `SELECT ... FOR UPDATE` row locks, which need a session-pinned connection.
# Transaction-mode pooling spreads a transaction's statements across backends
# and breaks the locks (observable as deadlocks). Session mode keeps them.
#
#   DATABASE_URL  session pooler (port 5432) — app runtime.
#   DIRECT_URL    session pooler (port 5432) — `prisma migrate` / `db push`.
#
# Grab both from Supabase → Connect → ORMs → Prisma (Session mode), and
# URL-encode any special characters in the password.

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth (NextAuth v5)
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
# Replaces the old JWT_SECRET. No fallback — the app refuses to boot without it.
AUTH_SECRET=""

# NOTE: the old Supabase JS keys (NEXT_PUBLIC_SUPABASE_URL / _PUBLISHABLE_KEY)
# are NOT used. This app talks to Postgres directly via Prisma and handles auth
# with NextAuth, so those keys are unnecessary.
